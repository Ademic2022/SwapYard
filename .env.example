# Copy to .env.local.

# Public site URL, used for Open Graph link previews.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Where the Next.js server reaches Django. /graphql, /api/csrf and /media are
# proxied there, so the browser only ever talks to the site's own origin.
API_INTERNAL_URL=http://127.0.0.1:8000

# Shared secret that lets Django trust the visitor IP this site forwards
# (set the same value as API_PROXY_SECRET on the server). Production only.
# API_PROXY_SECRET=
